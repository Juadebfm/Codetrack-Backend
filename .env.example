# SERVER
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# DATABASE
MONGODB_URI=

# Generate two different random secrets of at least 32 bytes each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Copy these from Mailtrap's SMTP tab for your selected sending domain or sandbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CodeTrack
# Port 465 uses TLS immediately; other ports require STARTTLS.
